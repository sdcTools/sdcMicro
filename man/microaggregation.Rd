## variable group size (V-MDAV): aggr is the minimum group size
mv <- microaggregation(
  obj = testdata[1:100, c("expend", "income", "savings")],
  method = "vmdav",
  aggr = 4,
  gamma = 1.1
)
table(table(mv$mx$expend))

## for objects of class sdcMicro:
## no stratification because `@strataVar` is `NULL`
